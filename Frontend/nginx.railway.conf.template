# Plantilla de nginx para el servicio "frontend" en Railway.
# nginx:alpine procesa automaticamente los archivos *.template en
# /etc/nginx/templates/ con envsubst y los escribe en /etc/nginx/conf.d/
# (mecanismo oficial de la imagen nginx:alpine, no requiere script propio).
#
# Variables esperadas como env vars del servicio Railway:
#   PORT                  -- Railway la inyecta automaticamente
#   BACKEND_INTERNAL_URL  -- referencia privada al servicio backend, p.ej.
#                            ${{backend.RAILWAY_PRIVATE_DOMAIN}}:8080
#                            (Railway resuelve esa referencia al desplegar)

server {
    listen ${PORT};
    server_name _;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;

        # Cabeceras de seguridad para el contenido estatico (mismo criterio que
        # nginx/nginx.conf usado en docker-compose): SOLO en location /, nunca en
        # /api/v1/ o /actuator/, porque esas rutas ya reciben sus propias cabeceras
        # de Spring Security -- duplicarlas aqui rompería la CSP del backend (ver
        # docs/mediciones/sec/owasp/OWASP-AUDIT.md, control A05).
        # HSTS para producción (requerido por OWASP y Lighthouse)
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        # script-src sin 'unsafe-inline'/'unsafe-eval' (auditoria 2026-09-05, alerta 10055 de
        # ZAP): el build de produccion es AOT y su index.html solo referencia bundles
        # externos con hash. Requiere inlineCritical=false en angular.json, si no Angular
        # difiere el CSS con un onload inline que esta politica bloquea y la app queda sin
        # estilos. Debe mantenerse identica a nginx/nginx.conf y a SecurityConfig.java.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none';" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Cache-Control "no-cache";
    }

    # Mismo fix que nginx/nginx.conf (Lighthouse, 2026-09-06): bundles con hash
    # inmutables, resto de estaticos con cache largo pero no inmutable.
    location ~* \.(?:js|css)$ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        # Este location define su propio add_header y por eso no hereda el HSTS de
        # location / (regla estandar de nginx) -- hallazgo real de la auditoria
        # 2026-09-13: los bundles JS/CSS se servian sin HSTS en produccion.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location ~* \.(?:png|jpg|jpeg|gif|svg|ico|webp|woff2?|ttf|eot)$ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=604800" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location /api/v1/ {
        proxy_pass http://${BACKEND_INTERNAL_URL}/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location /actuator/ {
        proxy_pass http://${BACKEND_INTERNAL_URL}/actuator/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
